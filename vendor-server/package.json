    "@mantine/dates": "^7.13.0",
    "@mantine/charts": "^7.13.0",
    "@prisma/client": "^6.11.1",
    "@tabler/icons-react": "^3.19.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.11.1",
    "typescript": "^5"
  }
