{
  "name": "smart-edms-vendor-server",
  "version": "1.0.0",
  "private": true,
  "description": "Smart EDMS — Vendor Licensing & Administration Server",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
