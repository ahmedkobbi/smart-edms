# Smart EDMS Vendor Server — Environment Template
#
# This server holds the Ed25519 PRIVATE KEY for license signing.
# NEVER commit the real .env file. Back up the private key in a password manager.

# Database (SQLite for dev, PostgreSQL for production)
VENDOR_DATABASE_URL=file:./vendor-server.db

# Ed25519 Key Pair (generate with: bun run src/gen-keys.ts)
# These are MULTILINE PEM keys — keep the \n escapes or use literal newlines
VENDOR_ED25519_PRIVATE_KEY=
VENDOR_ED25519_PUBLIC_KEY=

# Server
PORT=3001
NEXTAUTH_SECRET=change-me-to-a-random-string-min-32-chars

# Stripe (optional — for license purchase/renewal via web)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional — for expiry alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart EDMS <noreply@vendor.smartedms.local>"

# ============================================================================
# Ed25519 KEY PAIR (ACTUAL — generated 2026-08-12)
# The public key is embedded in both:
#   - electron/src/license/verify.ts (Electron desktop app)
#   - src/lib/billing/anti-crack.ts (web app)
# The private key is ONLY here — never commit, never share, never embed in client code.
# ============================================================================
VENDOR_ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIC52/Af6A0MW+YaBhmOuFU5b0Ut+3PJR4dPle7GhU1tF
-----END PRIVATE KEY-----"
VENDOR_ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEA5ovMYn22Om0x+uPQlRMojE7EdUAcGZWzXMdVpROQkR0=
-----END PUBLIC KEY-----"
