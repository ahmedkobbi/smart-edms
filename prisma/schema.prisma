  status       String   @default("active") // active | past_due | canceled | trialing
  seats        Int      @default(1)
  storageBytes BigInt   @default(1073741824) // 1GB default
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  // SECURITY FIX (L-ADM-6): Stripe identifiers for webhook reconciliation.
  // When Stripe is the source of truth for billing, the webhook uses these
  // to match events to tenants. Set when the customer first subscribes via
  // Stripe Checkout; null for trial / manually-managed subscriptions.
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ============================================================================
//  PAYMENT INVOICES (NowPayments crypto + Stripe card)
// ============================================================================
//
// SECURITY MODEL — strict payment security rules:
//
//   1. ZERO CLIENT TRUST: the client never sends a price. It sends only
//      { plan, billingCycle, idempotencyKey }. The server reads the price
//      from PLAN_PRICES_USD (server-side table) and writes `amountUsd`
//      to the invoice row. The client cannot tamper with the amount.
//
//   2. IDEMPOTENCY: `idempotencyKey` is a client-supplied UUID with a
//      UNIQUE constraint. If the client retries (network blip), the
//      server returns the existing invoice instead of creating a new one.
//      The unique constraint is enforced at the DB layer — race-safe.
//
//   3. WEBHOOK VERIFICATION: every webhook is verified via HMAC-SHA512
//      signature (NowPayments) or HMAC-SHA256 (Stripe) computed over the
//      RAW body. The signature secret is in NOWPAYMENTS_IPN_SECRET /
//      STRIPE_WEBHOOK_SECRET. Webhooks failing verification are dropped.
//
//   4. WEBHOOK-ONLY BUSINESS LOGIC: subscription activation runs ONLY in
//      the webhook handler. The /api/billing/return endpoint is DISPLAY
//      ONLY — it fetches invoice status for the UI but never mutates the
//      subscription. This prevents return-URL tampering (e.g. an attacker
//      crafting `/api/billing/return?invoice_id=xxx&status=confirmed`).
//
//   5. REPLAY PROTECTION: `processedWebhooks` stores the IDs of every
//      webhook event already processed. Duplicate deliveries (NowPayments
//      retries on 5xx) are a no-op — the status is already terminal.
//
//   6. ATOMIC STATUS TRANSITIONS: status changes use `updateMany WHERE
//      status IN (allowed_prev_states)` so two concurrent webhooks
//      cannot both transition the invoice. Only one wins; the other gets
//      count=0 and is a no-op.
//
//   7. UNDERPAYMENT PROTECTION: the webhook only transitions to
//      `confirmed` when `amountReceivedCrypto >= amountDueCrypto`. Partial
//      payments stay in `confirming` until the full amount arrives or the
//      invoice expires.
//
//   8. CRON RECONCILIATION: an hourly cron queries the NowPayments API
//      for every `pending`/`waiting`/`confirming` invoice and syncs the
//      status — catches missed webhooks (network outages, endpoint down).
//
//   9. INVOICE EXPIRY: crypto invoices expire (typically 20 min). The
//      cron marks expired invoices as `expired` and never activates the
//      subscription.
//
//  10. REFUND SAFETY: refunds require platform-admin + step-up auth and
//      are NEVER automatic. The `refunded` status is terminal.
//
//  11. AUDIT TRAIL: every status change is recorded as an audit event
//      with the actor (user/system/webhook/provider).

model PaymentInvoice {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String // who initiated the checkout

  // Provider fields
  provider        String   // 'nowpayments' | 'stripe'
  providerInvoiceId String? // NowPayments invoice_id or Stripe session_id
  providerPaymentId  String? // NowPayments payment_id (set when payment detected)

  // What was purchased — SERVER-AUTHORITATIVE (zero client trust)
  plan            String   // trial | starter | business | enterprise
  billingCycle    String   // 'monthly' | 'annual'
  seats           Int
  storageBytes    BigInt
  amountUsd       Float    // server-calculated price in USD (from PLAN_PRICES_USD)
  amountDueCrypto Float?   // crypto amount due (set by NowPayments)
  amountReceivedCrypto Float? // crypto amount actually received
  cryptoCurrency  String?  // BTC, ETH, USDT-TRC20, etc.
  payCurrency     String?  // currency the user chose to pay in

  // Idempotency — UNIQUE constraint prevents duplicate invoices
  idempotencyKey  String   @unique

  // Status machine: pending → waiting → confirming → confirmed | failed | expired | refunded
  status          String   @default("pending")

  // Webhook dedup — JSON array of processed webhook event IDs
  processedWebhooks String?

  // Pay URL (NowPayments-hosted invoice page; client redirects here)
  invoiceUrl      String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime? // invoice expiry (typically 20 min for crypto)
  confirmedAt     DateTime?
  refundedAt      DateTime?
  refundedBy      String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([provider, providerInvoiceId])
  @@index([provider, providerPaymentId])
  @@index([status, expiresAt]) // cron queries pending + expired
}

// ============================================================================
//  DOCUMENT TEXT INDEX (for OCR + full-text search)
// ============================================================================

model DocumentTextIndex {
  id           String   @id @default(cuid())
  tenantId     String
  documentId   String   @unique
  versionId    String
  extractedText String  @default("")
  // Raw extracted/OCR text (original case, no normalization) — used for
  // display snippets, AI/PII/summarization, and exports. The normalized
  // `extractedText` is used only for search indexing.
  rawText      String   @default("")
  ocrApplied   Boolean  @default(false)
  // OCR mean confidence (0-100). Only set when ocrApplied=true.
  // Documents with < 70% confidence should be flagged for human review.
  ocrConfidence Float?
  // Per-page confidence scores (JSON array of floats 0-100).
  ocrPageConfidences String @default("[]")
  // OCR engine used: 'tesseract_cli' | 'tesseract_js' | 'none'
  ocrEngine    String   @default("none")
  // Languages passed to the OCR engine (e.g. "eng+ara")
  ocrLanguages String   @default("")
  // OCR processing duration in milliseconds
  ocrDurationMs Int?
  language     String   @default("en")
  pageCount    Int      @default(0)
  indexedAt    DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document  Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding DocumentEmbedding?

  @@index([tenantId])
}

// ============================================================================
//  DOCUMENT EMBEDDINGS — for semantic / vector search
// ============================================================================

model DocumentEmbedding {
  id           String   @id @default(cuid())
  tenantId     String
  documentId   String   @unique
  textIndexId  String   @unique

  // The embedding vector, stored as a JSON-encoded array of floats.
  // We use JSON (rather than pgvector) for portability across SQLite (dev)
  // and Postgres (prod). On Postgres, a future migration can switch to
  // pgvector for native k-NN search; the application code below is the
  // abstraction boundary.
  vector       String   @default("[]") // JSON-encoded number[]

  // The model + dim that produced this vector — lets us invalidate
  // caches cleanly when we swap embedding models.
  model        String   @default("tfidf-bow-v1")
  dimensions   Int      @default(512)
  // A short semantic summary (LLM-generated when AI is enabled, or the
  // first 500 chars of extracted text otherwise). Stored so we can show
  // "why this matched" in the UI without re-running the LLM.
  summary      String   @default("")
  // Detected language of the source text (BCP-47, e.g. "en", "ar", "fr").
  language     String   @default("en")

  generatedAt  DateTime @default(now())
  // Hash of the source text — lets us skip regeneration when the
  // document content has not changed.
  sourceHash   String   @default("")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  textIndex DocumentTextIndex @relation(fields: [textIndexId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, model])
}

// ============================================================================
//  ANOMALY DETECTION
