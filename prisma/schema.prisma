// Smart EDMS — Prisma schema
// Multi-tenant Electronic Document Management System
// Database: SQLite (dev). The schema is portable to PostgreSQL by changing
// the datasource provider; row-level security can then be added in a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  TENANCY
// ============================================================================

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  status          String   @default("active") // active | suspended | deleted
  settings        String   @default("{}") // JSON blob: branding, residency, feature flags
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users                  User[]
  groups                 Group[]
  roles                  Role[]
  policies               Policy[]
  classifications        Classification[]
  metadataSchemas        MetadataSchema[]
  documents              Document[]
  folders                Folder[]
  workflows              Workflow[]
  workflowDefinitions    WorkflowDefinition[]
  retentionSchedules     RetentionSchedule[]
  legalHolds             LegalHold[]
  auditEvents            AuditEvent[]
  notifications          Notification[]
  shares                 Share[]
  apiKeys                ApiKey[]
  webhooks               Webhook[]
  sessions               Session[]
  accounts               Account[]
  verificationTokens     VerificationToken[]
  devices                Device[]
  classificationChanges  ClassificationChange[]
  comments               DocumentComment[]
  favorites              Favorite[]
  recentViews            RecentView[]
  savedSearches          SavedSearch[]
  redactions             Redaction[]
  dispositionRecords     DispositionRecord[]
  serviceAccounts        ServiceAccount[]
  stepUpSessions         StepUpSession[]
  documentEncryptionKeys DocumentEncryptionKey[]
  malwareScans           MalwareScan[]
  controlledVocabularies ControlledVocabulary[]
  invitations            Invitation[]
  recertificationCampaigns RecertificationCampaign[]
  breakGlassAccesses     BreakGlassAccess[]
  dualControlRequests    DualControlRequest[]
  revokedSessions        RevokedSession[]
  pushSubscriptions      PushSubscription[]
  notificationRoutings   NotificationRouting[]
  ssoProviders           SsoProvider[]
  auditReceipts          AuditReceipt[]
  subscription           Subscription?
  // NowPayments / Stripe payment invoices for crypto + card checkout.
  // SECURITY: every invoice has a unique idempotency key (prevents
  // duplicate charges from network retries) and a strict status machine
  // (pending → waiting → confirming → confirmed | failed | expired).
  // Business logic (subscription activation) runs ONLY in the webhook
  // handler, never on the success return URL.
  paymentInvoices        PaymentInvoice[]
  documentTextIndexes    DocumentTextIndex[]
  documentEmbeddings     DocumentEmbedding[]
  securityAnomalies      SecurityAnomaly[]
  userLocalePreferences  UserLocalePreference[]
  evidencePackages       EvidencePackage[]
  collaborationSessions  CollaborationSession[]
  permissions            Permission[]
  jobs                   Job[]
  localeResources        LocaleResource[]
  glossaryTerms          GlossaryTerm[]
  accessGrants           AccessGrant[]
}

// ============================================================================
//  IDENTITY & ACCESS
// ============================================================================

model User {
  id                String   @id @default(cuid())
  tenantId          String
  email             String
  emailVerified     DateTime?
  name              String?
  passwordHash      String?
  status            String   @default("active") // active | suspended | invited | locked
  mfaEnabled        Boolean  @default(false)
  mfaSecretEnc      String?  // encrypted TOTP secret
  mfaBackupCodesEnc String?  // encrypted JSON array of backup codes
  // Last successfully used TOTP timestep (for replay protection per RFC 6238 §5.2).
  // Any TOTP with a timestep <= this value is rejected.
  mfaLastTimestep   Int?
  passkeyCredentials String  @default("[]") // JSON array of WebAuthn credential descriptors
  lastLoginAt       DateTime?
  lastLoginIp       String?
  lastLoginUserAgent String?
  failedLoginAttempts Int    @default(0)
  lockedUntil       DateTime?
  sessionsRevokedAt DateTime? // mass-revoke timestamp; JWTs with iat < this are invalid
  avatarUrl         String?
  jobTitle          String?
  department        String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupMemberships GroupMember[]
  roleAssignments RoleAssignment[]
  documents       Document[]   @relation("DocumentOwner")
  documentVersions DocumentVersion[]
  auditEvents     AuditEvent[]
  approvals       Approval[]
  delegationsReceived ApprovalDelegation[]
  notifications   Notification[]
  shares          Share[]
  sessions        Session[]
  revokedSessions RevokedSession[]
  accounts        Account[]
  verificationTokens VerificationToken[]
  devices         Device[]
  pushSubscriptions PushSubscription[]
  workflowInitiated Workflow[]
  approvalDelegationsFrom ApprovalDelegation[] @relation("ApprovalDelegationFrom")
  classificationChangesAsActor ClassificationChange[]
  comments               DocumentComment[] @relation("UserComments")
  favorites              Favorite[] @relation("UserFavorites")
  recentViews            RecentView[] @relation("UserRecentViews")
  savedSearches          SavedSearch[] @relation("UserSavedSearches")
  stepUpSessions         StepUpSession[]
  dualControlRequested   DualControlRequest[] @relation("DualControlRequester")
  dualControlApproved    DualControlRequest[] @relation("DualControlApprover")
  recertificationItems   RecertificationItem[]
  localePreference       UserLocalePreference? @relation("UserLocalePreference")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Group {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  policies  Policy[]      @relation("PolicyGroup")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  tenantId  String
  addedAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions String   @default("[]") // JSON array of permission strings
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RoleAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  scope     String?  // optional scope: folder:abc or doc:xyz
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope])
  @@index([tenantId])
}

model Policy {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  effect      String   // allow | deny
  action      String   // e.g. "document:read", "*"
  resource    String   // e.g. "document:*", "folder:abc"
  conditions  String   @default("{}") // JSON: classification, hasTag, timeOfDay, etc.
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups  Group[] @relation("PolicyGroup")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  // We store only the hash; the raw key is shown ONCE at creation.
  keyHash     String   @unique
  keyPrefix   String   // first 8 chars for identification in UI
  scopes      String   @default("[]") // JSON array of permission strings
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdBy   String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Webhook {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  url         String
  events      String   @default("[]") // JSON array of event names
  secretHash  String?
  enabled     Boolean  @default(true)
  lastStatus  String?
  lastSentAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Device {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  // Human-readable name extracted from the User-Agent (e.g. "Chrome on macOS")
  name        String   @default("Unknown device")
  // Stable hash of (userId + userAgent) — used for upsert deduplication
  deviceHash  String   @unique
  // Full User-Agent string for forensic reference
  userAgent   String   @default("")
  // Legacy field — kept for backwards compat, same as deviceHash
  label       String   @default("")
  fingerprint String   @default("")
  trusted     Boolean  @default(false)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  lastIp      String?
  // Legacy field — same as lastIp
  lastSeenIp  String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId, trusted])
}

// ============================================================================
//  BROWSER PUSH NOTIFICATIONS (web-push)
// ============================================================================

model PushSubscription {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  endpoint    String   @unique
  p256dhKey   String
  authKey     String
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// ============================================================================
//  DOCUMENT MANAGEMENT
// ============================================================================

model Folder {
  id          String   @id @default(cuid())
  tenantId    String
  parentId    String?
  name        String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderTree")
  documents Document[]

  @@index([tenantId, parentId])
}

model Classification {
  id           String   @id @default(cuid())
  tenantId     String
  code         String   // e.g. "PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED", "HS"
  name         String
  description  String?
  level        Int      // 0=lowest, higher=more sensitive
  color        String   // hex banner color
  defaultPolicy String? // JSON policy snippet for documents of this class
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents         Document[]
  changesAsFrom     ClassificationChange[] @relation("ClassChangeFrom")
  changesAsTo       ClassificationChange[] @relation("ClassChangeTo")
  localizations     ClassificationLocalization[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model MetadataSchema {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  fields      String   // JSON: [{name,label,type,required,options,validation}]
  appliesTo   String   @default("*") // document type filter
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Document {
  id              String   @id @default(cuid())
  tenantId        String
  folderId        String?
  ownerId         String?
  title           String
  description     String?
  documentType    String   @default("generic") // contract, policy, invoice, etc.
  documentLanguage String  @default("en") // ISO 639-1: en, ar, fr, es, de
  textDirection   String   @default("ltr") // ltr | rtl
  classificationId String?
  tags            String   @default("[]") // JSON array
  metadata        String   @default("{}") // JSON
  state           String   @default("draft") // draft | active | record | archived | disposed
  isRecord        Boolean  @default(false)
  // OCR status: pending | processing | success | failed | low_confidence | skipped
  ocrStatus       String   @default("pending")
  isLocked        Boolean  @default(false)
  lockedBy        String?
  lockedReason    String?
  lockedUntil     DateTime?
  currentVersion  Int      @default(0)
  retentionScheduleId String?
  retentionStartDate DateTime?
  retentionDisposeAfter DateTime?
  // When the document was "closed" — used as the retention start trigger
  // for schedules with startTrigger='document.closed'. Set via the
  // /api/documents/:id/close endpoint (or when state transitions to 'record').
  closedAt        DateTime?
  legalHold       Boolean  @default(false)
  legalHoldReason String?
  legalHoldSetBy  String?
  legalHoldSetAt  DateTime?
  shareAllowed    Boolean  @default(false)
  downloadAllowed Boolean  @default(true)
  previewAllowed  Boolean  @default(true)
  watermarkEnabled Boolean @default(true)
  redactionCount  Int      @default(0)
  aiClassificationSuggested String? // suggested by AI, awaiting approval
  aiClassificationReason String?
  aiSuggestionState String? // pending | approved | rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder          Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  owner           User?          @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  classification  Classification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  versions        DocumentVersion[]
  approvals       Approval[]
  shares          Share[]
  classificationChanges ClassificationChange[]
  legalHoldJoins  LegalHoldDocument[] @relation("LegalHoldDocumentJoin")
  retentionSchedule RetentionSchedule? @relation(fields: [retentionScheduleId], references: [id], onDelete: SetNull)
  comments        DocumentComment[] @relation("DocumentComments")
  favorites       Favorite[]
  recentViews     RecentView[] @relation("DocumentRecentViews")
  redactions      Redaction[]
  encryptionKey   DocumentEncryptionKey?
  textIndex       DocumentTextIndex?
  embedding       DocumentEmbedding?
  workflows       Workflow[]
  dispositionRecords DispositionRecord[]

  @@index([tenantId, folderId])
  @@index([tenantId, state])
  @@index([tenantId, classificationId])
  @@index([tenantId, ownerId])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  tenantId      String
  documentId    String
  versionNumber Int
  storageKey    String   // path in object storage
  fileName      String
  mimeType      String
  sizeBytes     Int
  checksumSha256 String
  checksumSha1  String?
  uploadedById  String?
  changeReason  String?
  redacted      Boolean  @default(false)
  derivedFrom   String?  // parent version id, if this is a derivative (e.g. redacted)
  metadata      String   @default("{}") // JSON snapshot of doc metadata at this version
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@index([tenantId, documentId])
}

// ============================================================================
//  WORKFLOW & APPROVALS
// ============================================================================

model WorkflowDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  steps       String   // JSON: [{name, approverType, approverIds, mode, dueInHours, escalatesTo}]
  triggerEvent String? // document.upload | document.classify | manual
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflows Workflow[]

  @@index([tenantId])
}

model Workflow {
  id             String   @id @default(cuid())
  tenantId       String
  definitionId   String?
  documentId     String?
  initiatedById  String?
  name           String
  status         String   @default("pending") // pending | approved | rejected | cancelled | escalated
  currentStep    Int      @default(0)
  dueAt          DateTime?
  completedAt    DateTime?
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition  WorkflowDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  initiator   User?       @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  approvals   Approval[]

  @@index([tenantId, status])
  @@index([tenantId, documentId])
}

model Approval {
  id          String   @id @default(cuid())
  tenantId    String
  workflowId  String
  documentId  String?
  stepIndex   Int
  stepName    String
  approverId  String
  status      String   @default("pending") // pending | approved | rejected | delegated | escalated
  comment     String?
  signature   String?  // attestation hash
  delegatedTo String?
  dueAt       DateTime?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  // Step mode: 'all' = all approvers must approve; 'any' = first approver wins
  stepMode    String   @default("all")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver User     @relation(fields: [approverId], references: [id], onDelete: Cascade)
  delegations ApprovalDelegation[]

  @@index([tenantId, approverId, status])
  @@index([tenantId, workflowId])
}

model ApprovalDelegation {
  id           String   @id @default(cuid())
  approvalId   String
  fromUserId   String
  toUserId     String
  reason       String?
  delegatedAt  DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  fromUser User     @relation("ApprovalDelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User     @relation(fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
}

// ============================================================================
//  RETENTION, DISPOSITION & LEGAL HOLD
// ============================================================================

model RetentionSchedule {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  retentionDays   Int      // total retention from trigger event
  startTrigger    String   // document.created | document.closed | document.lastModified | custom
  dispositionAction String // delete | archive | review
  requireApproval Boolean  @default(true)
  appliesTo       String   @default("*") // document type filter
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LegalHold {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  reason      String
  caseRef     String?
  setById     String?
  releasedAt  DateTime?
  releasedBy  String?
  releaseReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents   LegalHoldDocument[] @relation("LegalHoldDocs")

  @@index([tenantId])
}

// Explicit join model for LegalHold <-> Document (many-to-many)
model LegalHoldDocument {
  id          String   @id @default(cuid())
  tenantId    String
  legalHoldId String
  documentId  String
  addedAt     DateTime @default(now())
  addedBy     String?

  legalHold  LegalHold @relation("LegalHoldDocs", fields: [legalHoldId], references: [id], onDelete: Cascade)
  document   Document  @relation("LegalHoldDocumentJoin", fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([legalHoldId, documentId])
  @@index([tenantId, documentId])
}

// ============================================================================
//  SHARING
// ============================================================================

model Share {
  id              String   @id @default(cuid())
  tenantId        String
  documentId      String
  createdBy       String?
  token           String   @unique
  recipientEmail  String?
  recipientUserId String?
  mode            String   @default("view") // view | download | review
  passwordHash    String?
  expiresAt       DateTime?
  maxViews        Int?
  viewCount       Int      @default(0)
  watermark       Boolean  @default(true)
  // Preferred locale of the external recipient — used to localize the
  // share notification email and the shared-document landing page.
  // Set when the share is created; can be updated by the recipient
  // from the shared page (future iteration).
  recipientLocale String?
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, documentId])
  @@index([token])
}

// ============================================================================
//  AUDIT (tamper-evident, hash-chained)
// ============================================================================

model AuditEvent {
  id           String   @id @default(cuid())
  tenantId     String
  sequenceNum  Int      // monotonic per-tenant sequence for chaining
  eventType    String   // auth.login | document.read | admin.policy.update ...
  actorId      String?
  actorEmail   String?
  actorIp      String?
  actorUserAgent String?
  action       String   // create | read | update | delete | login | approve | ...
  resourceType String?  // document | user | policy | classification ...
  resourceId   String?
  resourceName String?
  result       String   @default("allow") // allow | deny | error
  reason       String?
  correlationId String?
  sessionId    String?
  metadata     String   @default("{}") // JSON
  prevHash     String   // hash of previous event in chain
  eventHash    String   // hash of this event's contents (for verification)
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sequenceNum])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorId])
  @@index([tenantId, createdAt])
}

model ClassificationChange {
  id           String   @id @default(cuid())
  tenantId     String
  documentId   String
  fromClassId  String?
  toClassId    String?
  reason       String?
  actorId      String?
  isDowngrade  Boolean  @default(false)
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fromClass     Classification? @relation("ClassChangeFrom", fields: [fromClassId], references: [id], onDelete: SetNull)
  toClass       Classification? @relation("ClassChangeTo", fields: [toClassId], references: [id], onDelete: SetNull)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, documentId])
}

// ============================================================================
//  NOTIFICATIONS
// ============================================================================

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  type        String   // workflow.assigned | share.created | audit.anomaly ...
  title       String
  body        String
  severity    String   @default("info") // info | success | warning | critical
  link        String?
  readAt      DateTime?
  metadata    String   @default("{}") // JSON
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
}

// ============================================================================
//  NOTIFICATION ROUTING — severity + type-based delivery channel config
// ============================================================================

model NotificationRouting {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  // What triggers this route: severity level + optional type pattern
  minSeverity String   @default("warning") // info | success | warning | critical
  typePattern String   @default("*")       // e.g. "security.*", "workflow.*", "*"
  // Delivery channels — which methods to use for matching notifications
  channels    String   @default("[\"in_app\"]") // JSON array: in_app, email, webhook
  // Who receives — role-based routing
  targetRoles String   @default("[]") // JSON array of role names; empty = the notification's original recipient
  enabled     Boolean  @default(true)
  priority    Int      @default(100) // higher = evaluated first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
}

