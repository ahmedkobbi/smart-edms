// ============================================================================
//  SESSION REVOCATION LIST — JWT denylist for immediate logout
// ============================================================================
// When a user logs out, or an admin revokes their sessions, the JWT's `jti`
// claim is added to this table. The auth handler checks every request
// against this list and rejects revoked tokens immediately.
//
// Rows are garbage-collected after `expiresAt` (matches JWT `exp`).

model RevokedSession {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  jti          String   @unique // JWT ID claim — unique per token
  reason       String   @default("logout") // logout | admin_revoke | password_change | security
  revokedAt    DateTime @default(now())
  expiresAt    DateTime // when the JWT would have naturally expired

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

