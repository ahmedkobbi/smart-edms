  actorIp     String?
  metadata    String   @default("{}")
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolved, createdAt])
  @@index([tenantId, severity])
}

// ============================================================================
//  USER LOCALE PREFERENCES
// ============================================================================

model UserLocalePreference {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String   @unique
  locale       String   @default("en") // en | ar | fr | es | de
  timezone     String   @default("UTC")
  direction    String   @default("ltr") // ltr | rtl
  dateFormat   String   @default("yyyy-MM-dd")
  numberFormat String   @default("en-US")
  calendar     String   @default("gregory") // gregory | islamic | islamic-umalqura
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("UserLocalePreference", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ============================================================================
//  EVIDENCE PACKAGES (§9.12 — exportable audit evidence)
// ============================================================================

model EvidencePackage {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  createdBy       String
  status          String   @default("generating") // generating | ready | failed
  locale          String   @default("en") // locale for labels in the export
  periodStart     DateTime
  periodEnd       DateTime
  eventCount      Int      @default(0)
  documentCount   Int      @default(0)
  // JSON manifest of what's included: { auditEvents: bool, documents: bool, classifications: bool, etc. }
  manifest        String   @default("{}")
  // SHA-256 hash of the final package for integrity verification
  packageHash     String?
  // Storage key for the generated ZIP/file
  storageKey      String?
  fileSize        Int?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ============================================================================
//  COLLABORATIVE EDITING
// ============================================================================

model CollaborationSession {
  id           String   @id @default(cuid())
  tenantId     String
  documentId   String
  startedBy    String
  status       String   @default("active") // active | ended
  participantCount Int  @default(0)
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  endedAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, status])
}

model CollaborationPresence {
  id           String   @id @default(cuid())
  tenantId     String
  sessionId    String
  userId       String
  userEmail    String
  userName     String
  color        String   @default("#0ea5e9")
  cursorPos    Int      @default(0)
  lastSeen     DateTime @default(now())
  joinedAt     DateTime @default(now())

  @@index([sessionId])
  @@index([tenantId, userId])
}

// ============================================================================
//  ADDITIONAL CORE ENTITIES (§14.1)
// ============================================================================

model Permission {
  id          String   @id @default(cuid())
  tenantId    String
  code        String   // e.g. "document:read"
  description String?
  category    String   // document, admin, audit, workflow, etc.
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, category])
}

model Job {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // evidence_package, search_reindex, bulk_import, etc.
  status      String   @default("pending") // pending | running | completed | failed | cancelled
  progress    Int      @default(0) // 0-100
  result      String?  // JSON result
  error       String?
  startedBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, type])
}

model LocaleResource {
  id          String   @id @default(cuid())
  tenantId    String
  locale      String   // en, ar, fr, es, de
  namespace   String   // common, auth, documents, etc.
  key         String   // dot-notation key
  value       String   // translated value
  version     Int      @default(1)
  reviewStatus String  @default("draft") // draft | reviewed | approved
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locale, namespace, key])
  @@index([tenantId, locale])
}

model GlossaryTerm {
  id          String   @id @default(cuid())
  tenantId    String
  english     String
  arabic      String
  context     String?  // where this term is used
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, english])
}

model AccessGrant {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  grantedBy   String
  permission  String
  resourceType String?
  resourceId  String?
  scope       String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, resourceType, resourceId])
}

// Classification localization support
model ClassificationLocalization {
  id              String   @id @default(cuid())
  tenantId        String
  classificationId String
  locale          String
  name            String
  description     String?
  updatedAt       DateTime @updatedAt

  classification Classification @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  @@unique([classificationId, locale])
  @@index([tenantId, locale])
}
