# Smart EDMS — Environment template for LAN deployment
#
# Scenario: Server on enterprise LAN with outbound internet access.
# Copy to .env and fill in. NEVER commit the real .env file.
#
# See docs/LAN-DEPLOYMENT.md for the full deployment guide.
#
# Generate secrets with:
#   openssl rand -base64 32   # for NEXTAUTH_SECRET
#   openssl rand -hex 32      # for SMART_EDMS_KEK, METRICS_TOKEN, CRON_SECRET, WS_INTERNAL_SECRET
#   openssl rand -hex 16      # for POSTGRES_PASSWORD

# ============================================================================
# REQUIRED — the app will not start without these
# ============================================================================

# The URL employees use to access EDMS from the LAN.
# Use your internal DNS hostname (recommended) or the server's LAN IP.
# Examples:
#   https://smartedms.internal.company.dz    (internal DNS — recommended)
#   https://192.168.1.100                     (LAN IP — works but TLS warning)
NEXTAUTH_URL=https://smartedms.internal.company.dz

# JWT signing secret — generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Key Encryption Key (32 bytes hex) — for AES-256-GCM envelope encryption.
# Used to encrypt MFA secrets, SSO client secrets, backup codes, step-up tokens.
# LOSING THIS KEY = LOSING ACCESS TO ALL ENCRYPTED SECRETS. Back it up securely.
# Generate: openssl rand -hex 32
SMART_EDMS_KEK=

# PostgreSQL password — generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# MinIO (S3 storage) root password — generate: openssl rand -hex 16
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Cron secret (≥32 chars) for scheduled task endpoints — generate: openssl rand -hex 32
# Sent via X-Cron-Secret header or ?key= query param
CRON_SECRET=

# WebSocket internal auth secret — generate: openssl rand -hex 32
WS_INTERNAL_SECRET=

# ============================================================================
# SMTP — email notifications (password changes, MFA resets, workflow alerts)
# ============================================================================

# Option 1: Internal SMTP relay (most enterprises have one)
SMTP_HOST=mail.internal.company.dz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smartedms@company.dz
SMTP_PASS=
SMTP_FROM="Smart EDMS <smartedms@company.dz>"

# Option 2: External SMTP (works because server has internet egress)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Smart EDMS <your-gmail@gmail.com>"

# ============================================================================
# AI — optional LLM fallback for classification suggestions
# ============================================================================

# The heuristic classifier works without this. The LLM fallback calls an
# external API (works because the server has internet egress).
# If your corporate proxy blocks outbound API calls, set AI_LLM_ENABLED=false.
AI_API_KEY=
AI_LLM_ENABLED=true

# ============================================================================
# OpenSearch — semantic + full-text search (auto-configured in docker-compose.lan.yml)
# ============================================================================

# Do not set — the compose file points the app at the opensearch container.
# OPENSEARCH_HOST=http://opensearch:9200

# ============================================================================
# ClamAV — malware scanning (auto-configured in docker-compose.lan.yml)
# ============================================================================

# Do not set — the compose file points the app at the clamav container.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ============================================================================
# Metrics — Prometheus endpoint (bearer-token protected)
# ============================================================================

# Generate: openssl rand -hex 32
# Leave empty to disable the /api/metrics endpoint
METRICS_TOKEN=

# ============================================================================
# Sentry — optional error tracking (works via internet egress)
# ============================================================================

# Leave empty to disable Sentry
SENTRY_DSN=

# ============================================================================
# Web Push — browser push notifications (optional, may not work behind proxies)
# ============================================================================

# Generate with: npx web-push generate-vapid-keys
# If your corporate proxy blocks the Web Push service (Google FCM), leave these
# empty — in-app + email notifications will still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@smartedms.local

# ============================================================================
# CORS — leave empty for same-origin (LAN deployment)
# ============================================================================

# Empty = same-origin only (recommended for LAN)
# Set to a comma-separated list of origins if you need cross-origin access
CORS_ALLOW_ORIGIN=

# ============================================================================
# STRIPE / NOWPAYMENTS — DISABLED for LAN deployment
# ============================================================================
# These require inbound webhooks from the internet, which is not applicable
# for an internal deployment. Leave empty — the billing routes return 404
# and the SaaS tier is dormant.
#
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=

# ============================================================================
# System tuning (optional)
# ============================================================================

# Node environment (do not change in production)
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# E-SIGNATURE (DocuSign / Adobe Sign) — Optional
# ============================================================================
# Works via internet egress — DocuSign/Adobe Sign APIs are external.
# Leave empty to use the "internal" provider (in-app signing).

# DocuSign
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCOUNT_BASE_URL=
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_WEBHOOK_SECRET=

# Adobe Sign
ADOBE_SIGN_CLIENT_ID=
ADOBE_SIGN_CLIENT_SECRET=
ADOBE_SIGN_API_BASE=

# ============================================================================
# SECURITY AUDIT — Optional
# ============================================================================
SECURITY_AUDIT_EVIDENCE_DIR=/tmp/smartedms-evidence
