# Smart EDMS — environment template
# Copy to .env and fill in. NEVER commit the real .env file.

# Database (SQLite for dev; switch to postgresql URL for prod)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Key Encryption Key (32 bytes, hex or base64)
# Generate with: openssl rand -hex 32
# In production: load from KMS / HSM / secret manager
SMART_EDMS_KEK=

# File storage (local filesystem adapter by default)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/home/z/my-project/storage

# S3-compatible (set STORAGE_DRIVER=s3 to enable)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Optional AI provider (leave empty to use heuristic fallback)
# When set, classification suggestions use the LLM; otherwise heuristic.
AI_API_KEY=

# Bootstrap (used by scripts/seed.ts only)
SEED_ADMIN_EMAIL=admin@smartedms.local
SEED_ADMIN_PASSWORD=ChangeMe!2025
SEED_ADMIN_NAME=Smart EDMS Admin
SEED_TENANT_NAME=Default Tenant
