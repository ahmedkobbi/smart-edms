# Smart EDMS — Environment template
# Copy to .env and fill in. NEVER commit the real .env file.

# ============================================================================
# REQUIRED
# ============================================================================

# Database (SQLite for dev; PostgreSQL for production)
# Dev:    file:/home/z/my-project/db/custom.db
# Prod:   postgresql://user:password@host:5432/smartedms?schema=public
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string-min-16-chars

# Key Encryption Key (32 bytes)
# Generate: openssl rand -hex 32
# In production: load from KMS / HSM / secret manager
SMART_EDMS_KEK=

# ============================================================================
# STORAGE
# ============================================================================

# local = filesystem (dev), s3 = S3-compatible (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/home/z/my-project/storage

# S3 (required if STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ============================================================================
# SECURITY (optional)
# ============================================================================

# ClamAV host for malware scanning (optional — heuristic fallback if not set)
CLAMAV_HOST=

# Cron secret for scheduled tasks (workflow escalation)
# Generate: openssl rand -hex 32
# SECURITY (M-ADM-18): must be ≥32 chars. Send via X-Cron-Secret header
# (preferred) or ?key= query param (backwards compat).
CRON_SECRET=

# Metrics endpoint bearer token (M-ADM-17): /api/metrics refuses non-loopback
# requests without this token. Generate: openssl rand -hex 32
METRICS_TOKEN=

# Internal shared secret between the Next.js app and the WS notifications
# service (M-ADM-21): the WS /notify endpoint must require this on the
# Authorization: Bearer header. Generate: openssl rand -hex 32
WS_INTERNAL_SECRET=

# ============================================================================
# EMAIL (optional — console fallback if not set)
# ============================================================================

# SMTP configuration for email delivery (invitations, alerts, notifications)
# If not set, emails are logged to console in dev mode
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart EDMS <noreply@smartedms.local>

# ============================================================================
# WEBSOCKET (optional — polling fallback if not set)
# ============================================================================

# WebSocket notifications service URL (mini-services/notifications-service)
# If not set, client polls every 30s instead of real-time push
WS_SERVICE_URL=http://localhost:3003

# ============================================================================
# OPENSEARCH (optional — Prisma LIKE fallback if not set)
# ============================================================================

# OpenSearch host for production-grade full-text search with Arabic analyzers
# If not set, search falls back to Prisma LIKE queries (slower, no Arabic stemming)
OPENSEARCH_HOST=
OPENSEARCH_USER=
OPENSEARCH_PASS=
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=true

# ============================================================================
# SENTRY (optional — error tracking)
# ============================================================================

# Sentry DSN for production error tracking + performance monitoring
# If not set, Sentry is a no-op
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ============================================================================
# AI (optional)
# ============================================================================

# When set, classification/summarization uses LLM; otherwise heuristic
AI_API_KEY=

# ============================================================================
# SEED (used by scripts/seed.ts only — not needed at runtime)
# ============================================================================

SEED_ADMIN_EMAIL=admin@smartedms.local
SEED_ADMIN_PASSWORD=ChangeMe!2025
SEED_ADMIN_NAME=Smart EDMS Admin
SEED_TENANT_NAME=Default Tenant

# Redis (for BullMQ background job queues — OCR, webhooks, evidence, reindex)
# Required for production-grade job processing with retries + DLQ.
# Without Redis, jobs run in-process (fire-and-forget) with no retries.
REDIS_URL=redis://localhost:6379


# ClamAV (for malware scanning — optional but recommended for production)
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@smartedms.local

# S3 KMS (optional — for KMS-managed encryption instead of AES256)
# S3_KMS_KEY_ID=

# ============================================================================
# STRIPE (optional — when set, Stripe is the source of truth for billing)
# ============================================================================

# Stripe secret key — when set, PATCH /api/admin/billing only accepts
# platform-admin overrides. Normal plan changes come via the webhook.
# STRIPE_SECRET_KEY=sk_live_xxx

# Stripe webhook signing secret — used to verify the Stripe-Signature header
# on POST /api/billing/webhook. Generate in the Stripe dashboard.
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe price ID → local plan name mapping. Each price ID from the Stripe
# dashboard maps to a plan in the local DB.
# STRIPE_PRICE_TRIAL=price_xxx
# STRIPE_PRICE_STARTER=price_yyy
# STRIPE_PRICE_BUSINESS=price_zzz
# STRIPE_PRICE_ENTERPRISE=price_www
